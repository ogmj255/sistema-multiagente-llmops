# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Entornos virtuales de Python
.venv/
venv/
env/

# Archivos generados por Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Registros y archivos temporales
*.log
logs/
tmp/
temp/

# Datos y contratos procesados
data/raw/*
data/processed/*
data/evaluation/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/evaluation/.gitkeep

# Archivos locales de Docker
docker-compose.override.yml
