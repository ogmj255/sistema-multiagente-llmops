APP_NAME=Sistema Multiagente LLMOps
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_USER=tesis_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=clausulas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tesis_user:change_me@localhost:5432/clausulas_db

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=legal_knowledge

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024

# Proveedor del Agente Analizador Legal:
# local = Ollama
# remote = OpenRouter
# auto = OpenRouter con respaldo en Ollama
LEGAL_ANALYZER_MODE=local
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_APP_NAME=Sistema Multiagente LLMOps
OPENROUTER_SITE_URL=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
