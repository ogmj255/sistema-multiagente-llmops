# Copiar a .env en la raíz del repositorio. NO subir .env a Git.
# Separar secretos de operador/servidor de los de OpenRouter.
# Generar secretos aleatorios y largos. No reutilizar la clave de OpenRouter.

EXPERIMENT_ADMIN_TOKEN=
EXPERIMENT_OPERATOR_PASSWORD=

# Activar SOLO tras validar tests, dataset, ChromaDB y presupuesto.
# En false, la UI permite seguimiento pero NO solicita ejecuciones.
EXPERIMENT_EXECUTION_ENABLED=false
